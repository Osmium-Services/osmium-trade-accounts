{
    "id": "osmium-trade-accounts",
    "name": "Trade Accounts",
    "version": "0.2.0",
    "description": "B2B trade customer accounts: a status workflow, admin, and passwordless login. Customers come from your own admin or from a chosen source such as a CRM, through neutral hooks. Needs no shop and no CRM",
    "category": "business",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },
    "autoload": [
        "models"
    ],
    "migrations": "migrations/",
    "hooks": {
        "page.claim": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeClaim::page"
        ],
        "service.installed": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradePages::onEnabled"
        ],
        "service.enabled": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradePages::onEnabled"
        ],
        "service.disabled": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradePages::onDisabled"
        ],
        "service.removing": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradePages::onDisabled"
        ],
        "pages.protected_urls": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradePages::protectedUrls"
        ],
        "trade.application.received": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeEvents::received"
        ],
        "trade.customer.approved": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeEvents::approved"
        ],
        "trade.customer.suspended": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeEvents::suspended"
        ],
        "trade.customer.updated": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeEvents::updated"
        ],
        "trade.sources": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeLacrmHooks::source"
        ],
        "lacrm.form.submitted": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeLacrmHooks::formSubmitted"
        ],
        "lacrm.sale.won": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeLacrmHooks::saleWon"
        ],
        "lacrm.sale.lost": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeLacrmHooks::saleLost"
        ],
        "lacrm.contact.updated": [
            "Osmium\\Services\\TradeAccounts\\Models\\TradeLacrmHooks::contactUpdated"
        ]
    },
    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "trade-customers",
                    "label": "Trade Customers",
                    "icon": "bx bx-id-card",
                    "placement": "top",
                    "route": "admin/trade/customers",
                    "activePattern": "admin/trade/customers*",
                    "role": null
                },
                {
                    "id": "trade-settings",
                    "label": "Trade Accounts",
                    "icon": "bx bx-id-card",
                    "route": "admin/settings/trade",
                    "activePattern": "admin/settings/trade*",
                    "role": "admin"
                }
            ]
        },
        "routes": {
            "admin/trade/customers": {
                "controller": "controllers/TradeCustomersController.php",
                "class": "Osmium\\Services\\TradeAccounts\\Controllers\\TradeCustomersController",
                "method": "index",
                "title": "Trade Customers"
            },
            "admin/trade/customers/action": {
                "controller": "controllers/TradeCustomersController.php",
                "class": "Osmium\\Services\\TradeAccounts\\Controllers\\TradeCustomersController",
                "method": "action"
            },
            "admin/settings/trade": {
                "controller": "controllers/TradeSettingsController.php",
                "class": "Osmium\\Services\\TradeAccounts\\Controllers\\TradeSettingsController",
                "method": "index",
                "title": "Trade Accounts Settings"
            },
            "admin/trade/import": {
                "controller": "controllers/TradeImportController.php",
                "class": "Osmium\\Services\\TradeAccounts\\Controllers\\TradeImportController",
                "method": "index",
                "title": "Import Customers"
            },
            "admin/trade/import/action": {
                "controller": "controllers/TradeImportController.php",
                "class": "Osmium\\Services\\TradeAccounts\\Controllers\\TradeImportController",
                "method": "action"
            }
        }
    },
    "api": {
        "routes": {
            "api/trade-login": "controllers/trade-login.php",
            "api/trade-verify": "controllers/trade-verify.php",
            "api/trade-code": "controllers/trade-code.php",
            "api/trade-logout": "controllers/trade-logout.php"
        }
    },
    "setup": {
        "postInstallNote": "Add and approve customers under Trade Customers. Customer login and the public pages come in a later version."
    }
}
